@startuml
title Quy Trình Hủy Lịch Hẹn / Vắng Mặt (No-Show)

skinparam defaultFontName "Arial"
skinparam defaultFontSize 17
skinparam ActivityFontSize 17
skinparam ActivityDiamondFontSize 16
skinparam ArrowFontSize 15
skinparam SwimlaneTitleFontSize 20
skinparam TitleFontSize 24
skinparam SwimlaneWidth 410
skinparam ActivityBorderThickness 1.5
skinparam ActivityCornerRadius 12
skinparam shadowing false
skinparam wrapWidth 280
skinparam nodesep 90
skinparam ranksep 95

skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #0D9488
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #0D9488
skinparam SwimlaneBorderColor #CBD5E1
skinparam SwimlaneTitleBackgroundColor #F1F5F9
skinparam ArrowColor #0D9488

|Khách hàng|
start
:B1. Gửi yêu cầu hủy lịch hẹn;

|Hệ thống|
:B2. Kiểm tra vai trò thực hiện & thời gian;

if (Khách tự hủy ≥8h trước giờ hẹn\nhoặc do Lễ tân/Quản lý hủy giúp?) then (không)
  :B3. Từ chối tự hủy, yêu cầu gọi Hotline hỗ trợ;
  |Khách hàng|
  end
else (có)
endif

|Lễ tân / Quản lý|
:B4. Chọn hình thức xử lý: Hủy lịch HOẶC Không đến;

|Hệ thống|
if (Hình thức xử lý?) then (Hủy lịch)
  :B5. Trừ 10 điểm uy tín tài khoản;
  :B6. Giữ nguyên số buổi, giải phóng nhân sự & phòng;
  stop
else (Không đến / No-Show)
  if (Buổi thuộc Gói trả trước?) then (có - Nhóm B)
    :B7. Không trừ điểm uy tín;
    :B8. Trừ 01 buổi trị liệu (tính đã dùng);
  else (không - Nhóm A)
    :B9. Trừ 20 điểm uy tín tài khoản;
    :B10. Không trừ buổi trị liệu;
  endif
  stop
endif

@enduml
