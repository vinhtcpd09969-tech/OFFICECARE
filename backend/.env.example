PORT=5001
DATABASE_URL=postgresql://postgres:password@localhost:5432/office_care
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (Gmail SMTP) — dùng để gửi OTP đăng ký/quên mật khẩu. Để trống giá trị mặc định
# bên dưới thì hệ thống tự dùng tài khoản test Ethereal (xem link preview trong log server),
# không cần cấu hình gì thêm để chạy dev local.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# PayOS Configuration
PAYOS_CLIENT_ID=your_client_id_here
PAYOS_API_KEY=your_api_key_here
PAYOS_CHECKSUM_KEY=your_checksum_key_here

# Google Gemini API (trợ lý AI tư vấn & phân tích cảm xúc đánh giá) — lấy free tier tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

